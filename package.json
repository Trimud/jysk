{
  "name": "assemble-help",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run -s jysk:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "voice": "node --no-warnings --import ./scripts/voice/register.mjs scripts/voice/record.ts",
    "voice:names": "node --no-warnings --import ./scripts/voice/register.mjs scripts/voice/names.ts",
    "voice:check": "node --no-warnings --import ./scripts/voice/register.mjs scripts/voice/listen-check.ts",
    "jysk:discover": "node --no-warnings scripts/jysk/discover.ts",
    "jysk:fetch": "node --no-warnings scripts/jysk/fetch.ts",
    "jysk:build": "node --no-warnings --import ./scripts/voice/register.mjs scripts/jysk/build.ts && npm run -s qa:overlaps -- --jysk && node --no-warnings scripts/og/render.mjs --missing --if-available && npm run -s qa:snapshots -- --changed --if-available",
    "jysk:refresh": "npm run -s jysk:discover && npm run -s jysk:fetch -- --fresh && npm run -s jysk:build",
    "jysk:check": "node --no-warnings --import ./scripts/voice/register.mjs scripts/jysk/check.ts && npm run -s qa:overlaps -- --jysk",
    "families": "node scripts/families.mjs",
    "qa:snapshots": "node --no-warnings --import ./scripts/voice/register.mjs scripts/qa/snapshots.mjs",
    "qa:overlaps": "node --no-warnings --import ./scripts/voice/register.mjs scripts/qa/overlaps.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "1.54.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
