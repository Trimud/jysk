# Together AI key, for development only. The site never spends a key of its own:
# visitors paste theirs into the app, and every AI feature runs on it. Locally,
# pasting monta-dev-mock-key-000000 into the app uses this key instead (never in
# production). The recording scripts use it too: re-record the voice clips with
# `npm run voice`. Get a key at https://api.together.ai
TOGETHER_API_KEY=

# Optional: the GitHub repo shown (with its star count) in the nav.
# NEXT_PUBLIC_GITHUB_REPO=Trimud/jysk

# Optional: comma separated model lists, tried in order.
# TOGETHER_TEXT_MODEL=openai/gpt-oss-120b,zai-org/GLM-5.3-Flash,Qwen/Qwen3.8-Flash
# TOGETHER_VISION_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL,MiniMaxAI/MiniMax-M3,Qwen/Qwen3.5-9B
# TOGETHER_READ_MODEL=MiniMaxAI/MiniMax-M3,nvidia/NVIDIA-Nemotron-3.5-Super-VL,Qwen/Qwen3.5-9B
# TOGETHER_PLAN_MODEL=openai/gpt-oss-120b,zai-org/GLM-5.3-Flash,Qwen/Qwen3.7-Plus

# Feedback (src/lib/feedback.ts): a Redis on Upstash keeps every note people send. Add one from
# Vercel's marketplace (Storage, Upstash for Redis) and these are set for you; `vercel env pull .env.local`
# brings them here, and `npm run feedback` reads the newest notes. Without them, development writes to
# .feedback/feedback.jsonl and production only logs each note (grep the logs for [feedback]).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: the public URL, used for share cards, the sitemap and canonical links.
# NEXT_PUBLIC_SITE_URL=https://monta.online

# AI (Together, on each visitor's own key) and the voice: off for launch.
# Set to 1 to show the camera search, AI drafts, help chat, voice and "Powered by Together".
# Read at build time: rebuild after changing it.
# NEXT_PUBLIC_AI=1

# Optional: bring back the manual scanner at /scan (parked for v2).
# NEXT_PUBLIC_SCAN=1
